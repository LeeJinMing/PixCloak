    { "name": "Upload Ready", "short_name": "Upload Ready", "description": "Meet a portal's size and format requirements.", "url": "/upload-ready", "icons": [{ "src": "/icons/shortcut-upload-ready.png", "sizes": "96x96", "type": "image/png" }] },
